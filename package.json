{
  "name": "bannergress-api",
  "version": "0.2.0",
  "private": false,
  "description": "TypeScript client SDK for the Bannergress public API.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatyiFKBT/bannergress-api.git"
  },
  "homepage": "https://github.com/MatyiFKBT/bannergress-api#readme",
  "bugs": {
    "url": "https://github.com/MatyiFKBT/bannergress-api/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "generate": "bun scripts/generate.ts",
    "generate:offline": "bun scripts/generate.ts --offline",
    "openapi:sync": "bun scripts/sync-openapi.ts",
    "typecheck": "tsc --noEmit",
    "check:package": "publint && attw --pack . --profile esm-only",
    "check:size": "node scripts/check-size.mjs",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "bannergress"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@openapitools/openapi-generator-cli": "^2.42.1",
    "@types/bun": "latest",
    "@types/node": "^24.4.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^5"
  }
}
